<?php
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Iwoca\Iwocapay\ViewModel\CartBannerConfig $cartBannerConfig */
$cartBannerConfig = $block->getData('cart_banner_config');
$cartBannerConfigJson = json_encode(
    $cartBannerConfig->getConfig(),
    JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
);
?>
<script defer src="https://iwocapay-static.iwoca.com/sdk/sdk.iife.js"></script>
<script>
(function() {
    window.iwocapayBannerConfig = <?= /* @noEscape */ $cartBannerConfigJson ?>;

    // Banners frequently render below the fold (or never get scrolled to), and
    // load-fired events also count every bot/crawler pageview. Gate each view
    // event on a banner of that type actually intersecting the viewport — the
    // same approach the cart banner already uses (see js/cart-pricing.js). Where
    // IntersectionObserver is unavailable, fall back to firing immediately. The
    // in-memory + 24h dedup in integration-events.js collapses this to one view.
    var viewObserver = window.IntersectionObserver
        ? new IntersectionObserver(function(entries, observer) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    observer.unobserve(entry.target);
                    if (window.fireIwocapayBannerEvent) {
                        window.fireIwocapayBannerEvent(entry.target.iwocapayViewEvent);
                    }
                }
            });
        })
        : null;

    function fireViewOnVisible(elements, eventType) {
        if (!elements || !elements.length) return;
        if (!viewObserver) {
            if (window.fireIwocapayBannerEvent) window.fireIwocapayBannerEvent(eventType);
            return;
        }
        elements.forEach(function(el) {
            el.iwocapayViewEvent = eventType;
            viewObserver.observe(el);
        });
    }

    function hydrateBanners() {
        var signpostingBanners = [];
        var spendingLimitBanners = [];
        document.querySelectorAll('iwocapay-banner[data-banner-type]').forEach(function(wrapper) {
            if (wrapper.dataset.hydrated) return;
            wrapper.dataset.hydrated = 'true';

            var type = wrapper.dataset.bannerType;
            var tag = 'iwocapay-' + type + '-banner';
            var el = document.createElement(tag);

            var theme = wrapper.dataset.theme;
            if (theme) el.setAttribute('theme', theme);

            if (type.startsWith('signposting')) {
                signpostingBanners.push(wrapper);
                var duration = wrapper.dataset.duration;
                var interest = wrapper.dataset.interest;
                if (duration) el.setAttribute('duration', duration);
                if (interest) el.setAttribute('interest', interest);
            }

            if (type.startsWith('spending-limit')) {
                spendingLimitBanners.push(wrapper);
                var href = wrapper.dataset.href;
                var duration = wrapper.dataset.duration;
                if (href) el.setAttribute('href', href);
                if (duration) el.setAttribute('duration', duration);
                wrapper.addEventListener('click', function() {
                    if (window.fireIwocapayBannerEvent) {
                        window.fireIwocapayBannerEvent('CUSTOMER_CLICKED_SPENDING_LIMIT_BANNER');
                    }
                });
            }

            wrapper.appendChild(el);
        });

        fireViewOnVisible(signpostingBanners, 'CUSTOMER_VIEWED_BLOCK_BANNER');
        fireViewOnVisible(spendingLimitBanners, 'CUSTOMER_VIEWED_SPENDING_LIMIT_BANNER');
    }

    function formatGbp(value) {
        return new Intl.NumberFormat('en-GB', {
            style: 'currency',
            currency: 'GBP'
        }).format(value);
    }

    function fetchRepaymentAmounts() {
        var banners = document.querySelectorAll(
            'iwocapay-price-calculator-pdp-banner[data-amount], iwocapay-price-calculator-plp-banner[data-amount]'
        );

        fireViewOnVisible(banners, 'CUSTOMER_VIEWED_PRICING_BANNER');

        var requests = {};

        banners.forEach(function(banner) {
            var amount = parseFloat(banner.dataset.amount);
            var months = banner.dataset.months || '3';

            // The 30-day offer shows "Pay nothing for 30 days" — no repayment figure.
            if (isNaN(amount) || months === '1') return;

            // If catalog prices exclude VAT, gross up so repayments reflect what
            // the customer actually pays (matches the Shopify integration).
            var vat = banner.dataset.vat;
            var principal = vat === 'excluding' ? amount * 1.2 : amount;

            if (principal < 5) return;

            // Interest-free terms are pure division — compute client-side, no API call.
            var interest = banner.dataset.interest;
            if (interest !== 'buyer-pays') {
                banner.setAttribute('repayment-amount', formatGbp(principal / parseInt(months, 10)));
                return;
            }

            var key = principal + '_' + months + '_' + interest;

            if (!requests[key]) {
                var url = '/iwocapay/banner/pricing?amount=' + encodeURIComponent(principal)
                    + '&months=' + encodeURIComponent(months)
                    + '&pricing=' + encodeURIComponent(interest);
                requests[key] = fetch(url, {credentials: 'omit'}).then(function(res) { return res.json(); });
            }

            requests[key].then(function(data) {
                if (data.repayment_amount) {
                    banner.setAttribute('repayment-amount', formatGbp(data.repayment_amount));
                }
            }).catch(function() {});
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            hydrateBanners();
            fetchRepaymentAmounts();
        });
    } else {
        hydrateBanners();
        fetchRepaymentAmounts();
    }
})();
</script>
